{
  "name": "human_touch",
  "description": "HumanTouch (EgoPro) annotated MCAP shards; pass --shard X001 to select one demo subdirectory.",
  "input_dir": "data/ego_pro/demo/{shard}",
  "output_dir": "data/ego_pro_processed/{shard}",

# The MIT lN cluster (RTX A6000 nodes lN.mit.edu, shared NFS home /homes/jiamingt) driven from the control host x5: every
# published RoboDojo number of the SANA adapters in this fork comes from this site. See site.env.example for the meaning
# of each variable.

CE_SSH_USER=jiamingt
CE_SSH_DOMAIN=.mit.edu
# pull/dispatch order: healthy nodes first, the slowest NFS client (l27) last. 2026-10-15: every reachable node is back (l2 l9
# l25 l30 after the 2026-10-12..14 NFS outage), l4 unreachable; l0 NOT ours from the sana latent no-CFG checkpoint on (user).
CE_NODES="l7 l25 l1 l5 l6 l2 l9 l8 l30 l3 l26 l27"
CE_RESERVE="l3:0 l26:1 l30:5"        # another user's vLLM boards (l3:0, l26:1); l30 CUDA 5 unusable since 2026-10-09
CE_GATEWAY=l7                        # l5 degraded 2026-10-12
CE_TAIL_EXCLUDE_NODES="l2 l6"

CE_SHARED_HOME=/homes/jiamingt
CE_REMOTE_INSTALL=$CE_SHARED_HOME/robodojo_install
CE_EVAL_ROOT=$CE_SHARED_HOME/robodojo_eval
CE_REMOTE_XPL=$CE_SHARED_HOME/xpl_zekai/XPolicyLab
CE_REMOTE_PYDEPS=$CE_SHARED_HOME/xpl_zekai/pydeps
CE_CKPT_ROOT=$CE_SHARED_HOME/checkpoints/huggingface/logits
CE_TEXT_ENCODER_PATH=$CE_SHARED_HOME/Sana/output/pretrained_models/text_encoder/gemma-2-2b-it
CE_VAE_PATH=$CE_SHARED_HOME/Sana/output/pretrained_models/LTX-2.3-Diffusers

CE_NODE_ROOT=/dataset2/jiamingt/robodojo
CE_NODE_XPL_WS=$CE_NODE_ROOT/xpl_zekai_ws

CE_PY=$HOME/miniforge3/envs/sana-wam/bin/python
CE_MASTER_ROOT=$HOME/robodojo_master
CE_RESULTS_ROOT=$HOME/zekail/robodojo_results
CE_ROBODOJO_CHECKOUT=$HOME/zekail/sana_wam_sim_benchmarks/RoboDojo-official-clone-20260823

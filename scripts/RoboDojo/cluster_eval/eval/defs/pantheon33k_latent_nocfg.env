# shellcheck shell=bash
# The Pantheon33k sana latent recipe trained WITHOUT condition dropout, served with guidance OFF (user 2026-10-15: "下载logits/sft_
# robodojo_eefabs_sana_latent_256x320_vanilla_pantheon33k_aligned_f33fps8_nocfg然后做全量测试，这是sana latent不开cfg的版本"): three-view
# strip 3 x 256x320, donor e8s33139 (the dropout twin's), Sana 9da55937e, stretch, whole 32-target chunks. Queued behind the
# Pantheon14k openwam series; from this checkpoint on l0 is not used (sites/mit_l.env CE_NODES).
# Original chain: eval/campaigns/pantheon33k_latent_nocfg_allgpu_seeds.sh (reference site).
# Launch: bash eval/campaign.sh eval/defs/pantheon33k_latent_nocfg.env show | verify | chain start   (RUNBOOK.md)
CAMPAIGN=pantheon33k_latent_nocfg_allgpu          # chain dir <CE_MASTER_ROOT>/.scratch/chain_pantheon33k_latent_nocfg_allgpu
ADAPTER=SANA_WAM
KEYS="a"
LABEL_a=eefabs_sana_latent_256x320_vanilla_pantheon33k_aligned_f33fps8_nocfg
HF_a=logits/sft_robodojo_eefabs_sana_latent_256x320_vanilla_pantheon33k_aligned_f33fps8_nocfg
NORM_a=9f8b98ede445f554cafef99974a0ef67ce4d59292578ccbdeaba704c9cedd5ba   # <snapshot>/config.yaml normalization_sha256
EXPECT_a='visual_layout=three_view_strip|state_as_cross_attention=False|video_fps=8|video_frame_stride=4|multiview=sana_latent|spatial_rope_tile=(8, 16)|rope=aligned|text_groups=4|robot_base_eef_layout=eef_only'
VIDEO_CFG=1; ACTION_CFG=1   # guidance OFF: no unconditional pass (trained without condition dropout)
NAME_a=nocfg                  # the short name reports use
SEEDS="0 1 2"
WAIT_RUNS="official_seed0_eefabs_openwam_384x320_vanilla_pantheon14k_aligned_f33fps8_xpl_vcfg6_acfg1_nfe10_vfs5_afs1_ee official_seed1_eefabs_openwam_384x320_vanilla_pantheon14k_aligned_f33fps8_xpl_vcfg6_acfg1_nfe10_vfs5_afs1_ee official_seed2_eefabs_openwam_384x320_vanilla_pantheon14k_aligned_f33fps8_xpl_vcfg6_acfg1_nfe10_vfs5_afs1_ee"
BASELINE_a=official_seed0_eefabs_sana_latent_256x320_vanilla_pantheon33k_aligned_f33fps8_xpl_vcfg6_acfg1_nfe10_vfs5_afs1_ee   # the dropout twin at video CFG 6 (958/6300)
BASELINE_NAME_a=cfg6

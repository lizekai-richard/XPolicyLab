# shellcheck shell=bash
# TWO checkpoints per seed in parallel (each on half of the free GPUs): the Pantheon2k sana latent pair (user 2026-10-02: "和之前一样同步
# 测3个seed"), donor sana_rwm_pretrained_vanilla_pantheon_e1s2000, three-view strip 3 x 256x320, stretch:
#   a = fixed_resize (stretch latent store, no augmentation)   3 seeds 14.31 / 20.99, 929/6300
#   b = videoaug (VAE encoded online, video augmentation p 0.5)  3 seeds 15.46 / 21.62, 1018/6300
# Original chain: eval/campaigns/pantheon_stretch_pair_seeds.sh (40 GPUs per checkpoint then).
# Launch: bash eval/campaign.sh eval/defs/pantheon2k_latent_pair.env show | verify | chain start   (eval/RUNBOOK.md)
CAMPAIGN=pantheon_stretch_pair
ADAPTER=SANA_WAM
KEYS="a b"
LABEL_a=eefabs_sana_latent_256x320_pantheon2k_aligned_f33fps8_fixed_resize
HF_a=logits/sft_robodojo_eefabs_sana_latent_256x320_pantheon2k_aligned_f33fps8_fixed_resize
NORM_a=9f8b98ede445f554cafef99974a0ef67ce4d59292578ccbdeaba704c9cedd5ba
LABEL_b=eefabs_sana_latent_256x320_pantheon2k_aligned_f33fps8_videoaug
HF_b=logits/sft_robodojo_eefabs_sana_latent_256x320_pantheon2k_aligned_f33fps8_videoaug
NORM_b=1fe3b7e72e8fa93eca5efb8a8deeace1daf4434b4b97e9f4445670ac758287ed
EXPECT_a='visual_layout=three_view_strip|state_as_cross_attention=False|video_fps=8|video_frame_stride=4|multiview=sana_latent|spatial_rope_tile=(8, 16)|rope=aligned|text_groups=4|robot_base_eef_layout=eef_only'
EXPECT_b=$EXPECT_a
SEEDS="0 1 2"
MIN_PER_RUN=20
NAME_a=fixed_resize; NAME_b=videoaug
BASELINE_NAME_a=videoaug; BASELINE_NAME_b=fixed_resize
BASELINE_a=official_seed0_eefabs_sana_latent_256x320_pantheon2k_aligned_f33fps8_videoaug_xpl_vcfg6_acfg1_nfe10_vfs5_afs1_ee
BASELINE_b=official_seed0_eefabs_sana_latent_256x320_pantheon2k_aligned_f33fps8_fixed_resize_xpl_vcfg6_acfg1_nfe10_vfs5_afs1_ee

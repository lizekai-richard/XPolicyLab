WAIT_RUNS="official_seed0_eefabs_sana_pixel_320x512_vanilla_pantheon14k_aligned_f33fps8_nocfg_xpl_vcfg1_acfg1_nfe10_vfs5_afs1_ee official_seed1_eefabs_sana_pixel_320x512_vanilla_pantheon14k_aligned_f33fps8_nocfg_xpl_vcfg1_acfg1_nfe10_vfs5_afs1_ee official_seed2_eefabs_sana_pixel_320x512_vanilla_pantheon14k_aligned_f33fps8_nocfg_xpl_vcfg1_acfg1_nfe10_vfs5_afs1_ee"   # queued behind the whole no-CFG series
BASELINE_a=official_seed0_eefabs_sana_pixel_320x512_vanilla_pantheon14k_aligned_f33fps8_xpl_vcfg6_acfg1_nfe10_vfs5_afs1_ee   # the Pantheon14k pixel on the same donor (3 seeds 956/6300)
BASELINE_NAME_a=p14k_pixel

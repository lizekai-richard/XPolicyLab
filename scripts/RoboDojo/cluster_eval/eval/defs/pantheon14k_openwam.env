# shellcheck shell=bash
# The OpenWAM-canvas SFT on the Pantheon14k donor (user 2026-10-12: "请你再下载logits/sft_robodojo_eefabs_openwam_384x320_vanilla_pantheon14k_
# aligned_f33fps8，这是我又用openwam模式sft的结果，请你排队测试"): OpenWAM L-shaped 384x320 canvas on the one policy class, donor
# sanapixel_pantheon_e4s14173 (= the Pantheon14k pixel's donor), condition dropout 0.1, Sana 9da55937e, epoch 10 / step 36,180.
# Default sampling (video CFG 6, action CFG 1, 10 steps, flow shifts 5 / 1), whole 32-target chunks, 3 seeds one at a time.
# Original chain: eval/campaigns/pantheon14k_openwam_allgpu_seeds.sh.
# Launch: bash eval/campaign.sh eval/defs/pantheon14k_openwam.env show | verify | chain start   (eval/RUNBOOK.md)
CAMPAIGN=pantheon14k_openwam_allgpu          # chain dir <CE_MASTER_ROOT>/.scratch/chain_pantheon14k_openwam_allgpu (the name the original chain used)
ADAPTER=SANA_WAM
KEYS="a"
LABEL_a=eefabs_openwam_384x320_vanilla_pantheon14k_aligned_f33fps8
HF_a=logits/sft_robodojo_eefabs_openwam_384x320_vanilla_pantheon14k_aligned_f33fps8
NORM_a=9f8b98ede445f554cafef99974a0ef67ce4d59292578ccbdeaba704c9cedd5ba   # <snapshot>/config.yaml normalization_sha256
EXPECT_a='visual_layout=openwam_canvas|state_as_cross_attention=False|video_fps=8|video_frame_stride=4|multiview=openwam|rope=aligned|text_groups=1|canvas_prompt=two_rows|robot_base_eef_layout=eef_only'
NAME_a=p14k_openwam                  # the short name reports use

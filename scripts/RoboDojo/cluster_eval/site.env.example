# Site configuration of the RoboDojo cluster evaluation (cluster_eval). Copy to site.env (or point CE_SITE at a file) and
# fill in every value; sites/mit_l.env is the cluster all published SANA numbers were produced on. Every shell entry point
# sources this file through lib/site.sh; python helpers read the exported CE_* variables (lib/ce_site.py).
#
# Two kinds of machines:
#   control host  runs the masters, the campaign chains and the reports (needs: bash, rsync, ssh keys for the nodes, a python
#                 with pyyaml, a RoboDojo checkout for planning and the official summarize_result.py)
#   GPU nodes     run one simulator + one policy server per GPU; they share a home directory (CE_SHARED_HOME) where the run
#                 roots, the worker scripts (deploy.sh) and the checkpoints live, and keep the heavy environments node-local

# ---- nodes ---------------------------------------------------------------------------------------------------------------
CE_SSH_USER=youruser                 # ssh login on the GPU nodes
CE_SSH_DOMAIN=.example.edu           # appended to a node name: <node><domain>, e.g. node1.example.edu
CE_NODES="node1 node2"               # default node list of a campaign; the order is also the master's pull order (healthy first)
CE_RESERVE=""                        # 'node:cuda_index' boards never used (another user's service, a broken board)
CE_GATEWAY=node1                     # the node the control host rsyncs through to reach the shared home
CE_TAIL_EXCLUDE_NODES=""             # nodes whose idle slots the tail template must not count (known-bad boards)

# ---- shared home (as seen from the nodes) --------------------------------------------------------------------------------
CE_SHARED_HOME=/home/youruser                         # $HOME on the nodes (NFS)
CE_REMOTE_INSTALL=$CE_SHARED_HOME/robodojo_install    # deploy.sh puts eval/ + node/ + site.env here; workers run from here
CE_EVAL_ROOT=$CE_SHARED_HOME/robodojo_eval            # one run root per run: <CE_EVAL_ROOT>/<run>/units/<unit>/a<N>/...
CE_REMOTE_XPL=$CE_SHARED_HOME/xpl/XPolicyLab          # the XPolicyLab checkout the policy servers import (deploy.sh)
CE_REMOTE_PYDEPS=$CE_SHARED_HOME/xpl/pydeps           # extra pure-python deps of the SANA adapters (websockets, msgpack, ...)
CE_CKPT_ROOT=$CE_SHARED_HOME/checkpoints/huggingface/logits   # <CE_CKPT_ROOT>/<label> = one checkpoint snapshot
# encoders the SANA adapters load next to every checkpoint (policy/SANA_WAM/INSTALLATION.md section 2: public HF mirrors
# Efficient-Large-Model/gemma-2-2b-it and Efficient-Large-Model/LTX-2.3-Diffusers, vae/ only)
CE_TEXT_ENCODER_PATH=$CE_SHARED_HOME/sana_wam_assets/gemma-2-2b-it
CE_VAE_PATH=$CE_SHARED_HOME/sana_wam_assets/LTX-2.3-Diffusers

# ---- node-local --------------------------------------------------------------------------------------------------------
CE_NODE_ROOT=/local/youruser/robodojo                 # envs, the RoboDojo checkout, activate_sana_wam.sh (node/install_*.sh)
CE_NODE_XPL_WS=$CE_NODE_ROOT/xpl_ws                   # node-local workspace the official client writes eval_result/ into
# node runtime contract (node/install_node.sh + node/install_sana_wam.sh, or by hand): $CE_NODE_ROOT/activate.sh exports
# SANA_SIM_PY (Isaac/RoboDojo python) and ROBODOJO_CHECKOUT (RoboDojo at the pin below); $CE_NODE_ROOT/activate_sana_wam.sh
# exports SANA_PY (the policy-server python, an env built per policy/SANA_WAM/INSTALLATION.md section 1)

# ---- control host --------------------------------------------------------------------------------------------------------
CE_PY=$HOME/miniforge3/envs/sana-wam/bin/python       # python3 with pyyaml (the master, the reports and RoboDojo's summarize_result.py)
CE_MASTER_ROOT=$HOME/robodojo_master                  # master state dirs (state.json, master.log, mirror/), chain dirs
CE_RESULTS_ROOT=$HOME/robodojo_results                # consolidated results tree: runs/<run>/OFFICIAL_SUMMARY*.md, reports
CE_ROBODOJO_CHECKOUT=$HOME/RoboDojo                   # RoboDojo checkout at the pinned commit (task configs, summarize_result.py)
